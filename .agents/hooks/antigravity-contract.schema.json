{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ag-kit.dev/schemas/antigravity-contract.schema.json",
  "title": "AG Kit Antigravity Runtime Contract",
  "type": "object",
  "required": ["schemaVersion", "runtime", "requiredCliCommands", "phases"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0.0"},
    "runtime": {"const": "antigravity"},
    "requiredCliCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["changelog", "plugin", "plugins", "update"]}
    },
    "phases": {"type": "object"}
  },
  "additionalProperties": false
}
